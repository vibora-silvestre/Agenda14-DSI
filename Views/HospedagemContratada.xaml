<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.HospedagemContratada"
             Title="Resumo da Reserva"
             BackgroundColor="#F4F6F9">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

        
            <Label Text="{Binding QuartoSelecionado.Descricao}" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#1E293B" 
                   HorizontalOptions="Center" 
                   Margin="0,10,0,5"/>

            <!--usuario-->
            <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 12" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Hóspedes Registados" FontAttributes="Bold" FontSize="16" TextColor="#334155"/>
                    <Grid ColumnDefinitions="*, *">
                        <Label Text="{Binding QntAdultos, StringFormat='Adultos: {0}'}" TextColor="#64748B" FontSize="14"/>
                        <Label Text="{Binding QntCriancas, StringFormat='Crianças: {0}'}" Grid.Column="1" TextColor="#64748B" FontSize="14" HorizontalTextAlignment="End"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- periodo -->
            <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 12" Padding="15">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Datas da Estadia" FontAttributes="Bold" FontSize="16" TextColor="#334155"/>
                    <Grid ColumnDefinitions="*, *, *">
                        <VerticalStackLayout>
                            <Label Text="Check-in" FontSize="12" TextColor="#94A3B8"/>
                            <Label Text="{Binding DataCheckIn, StringFormat='{0:dd/MM/yyyy}'}" FontAttributes="Bold" TextColor="#1E293B" FontSize="14"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Check-out" FontSize="12" TextColor="#94A3B8"/>
                            <Label Text="{Binding DataCheckOut, StringFormat='{0:dd/MM/yyyy}'}" FontAttributes="Bold" TextColor="#1E293B" FontSize="14"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2">
                            <Label Text="Noites" FontSize="12" TextColor="#94A3B8" HorizontalTextAlignment="End"/>
                            <Label Text="{Binding Estadia}" FontAttributes="Bold" TextColor="#1E293B" FontSize="14" HorizontalTextAlignment="End"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- total -->
            <Border Stroke="#0F172A" StrokeThickness="2" BackgroundColor="#0F172A" StrokeShape="RoundRectangle 12" Padding="20">
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label Text="Valor Total da Estadia" FontSize="14" TextColor="#94A3B8" HorizontalOptions="Center"/>
                    <Label Text="{Binding ValorTotal, StringFormat='R$ {0:F2}'}" FontSize="28" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!--votla -->
            <Button Text="Voltar" 
                    Clicked="Button_Clicked"
                    BackgroundColor="#E2E8F0"
                    TextColor="#1E293B"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="10"
                    HeightRequest="50"
                    Margin="0,10,0,20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>