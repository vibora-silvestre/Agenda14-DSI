<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.Sobre"
             Title="Sobre o Aplicativo"
             BackgroundColor="#F4F6F9">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
       
            <Button Text="Voltar para Reserva" 
                    Clicked="Voltar_Clicked"
                    BackgroundColor="#0F172A"
                    TextColor="White"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    HeightRequest="42"/>

            
            <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 12" Padding="25">
                <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                    
                    <Image Source="dotnet_bot.png" 
                           WidthRequest="80" 
                           HeightRequest="80" 
                           HorizontalOptions="Center" />

                    <Label Text="Sistema de Hospedagem" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" 
                           TextColor="#0F172A" />

                    <Label Text="Aplicativo desenvolvido para agenda 13 e 14 da disciplina de Desenvolvimento de Sistemas 2 para cálculo avançado de diárias e gestão de reservas de hoteis." 
                           FontSize="14"
                           HorizontalTextAlignment="Center" 
                           TextColor="#475569" />

                    <BoxView HeightRequest="1" Color="#F1F5F9" WidthRequest="250" HorizontalOptions="Center" />

                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                               <Label Text="Desenvolvido por: Rafaela Alves de Lima" 
                               FontSize="14" 
                               HorizontalOptions="Center" 
                               TextColor="#334155"/>

                        <Label Text="Ano: 2026" 
                               FontSize="14" 
                               HorizontalOptions="Center" 
                               TextColor="#334155"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>